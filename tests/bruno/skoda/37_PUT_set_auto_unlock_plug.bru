meta {
  name: POST set auto-unlock plug
  type: http
  seq: 37
}

put {
  url: {{base_url}}/api/v1/charging/{{vin}}/set-auto-unlock-plug
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "autoUnlockPlug": "PERMANENT"
  }
}

docs {
